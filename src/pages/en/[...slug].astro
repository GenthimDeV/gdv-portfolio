---
import HomePage from '../../components/HomePage.astro';
import CaseStudyPage from '../../components/CaseStudyPage.astro';
import AboutPage from '../../components/AboutPage.astro';
import ProjectsPage from '../../components/ProjectsPage.astro';
import LabPage from '../../components/LabPage.astro';
import ExperimentPage from '../../components/ExperimentPage.astro';
import { experimentSlug, getExperiments } from '../../lib/experiments';
import { getProjects, projectSlug } from '../../lib/projects';
import { getSlug, routeKeys } from '../../i18n';

const locale = 'en';

export async function getStaticPaths() {
  const pages = routeKeys.map((route) => ({
    params: { slug: getSlug(route, 'en') },
    props: { route, project: undefined, experiment: undefined },
  }));
  const cases = (await getProjects('en')).map((project) => ({
    params: { slug: `${getSlug('projects', 'en')}/${projectSlug(project)}` },
    props: { route: 'projects' as const, project, experiment: undefined },
  }));
  const experiments = (await getExperiments('en')).map((experiment) => ({
    params: { slug: `${getSlug('lab', 'en')}/${experimentSlug(experiment)}` },
    props: { route: 'lab' as const, project: undefined, experiment },
  }));
  return [...pages, ...cases, ...experiments];
}

const { route, project, experiment } = Astro.props;
---

{
  project ? (
    <CaseStudyPage project={project} locale={locale} />
  ) : experiment ? (
    <ExperimentPage experiment={experiment} locale={locale} />
  ) : route === 'projects' ? (
    <ProjectsPage locale={locale} />
  ) : route === 'lab' ? (
    <LabPage locale={locale} />
  ) : route === 'about' ? (
    <AboutPage locale={locale} />
  ) : (
    <HomePage locale={locale} />
  )
}
