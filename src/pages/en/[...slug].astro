---
import HomePage from '../../components/HomePage.astro';
import CaseStudyPage from '../../components/CaseStudyPage.astro';
import ProjectsPage from '../../components/ProjectsPage.astro';
import PlaceholderPage from '../../components/PlaceholderPage.astro';
import { getProjects, projectSlug } from '../../lib/projects';
import { getSlug, routeKeys } from '../../i18n';

const locale = 'en';

export async function getStaticPaths() {
  const pages = routeKeys.map((route) => ({
    params: { slug: getSlug(route, 'en') },
    props: { route, project: undefined },
  }));
  const cases = (await getProjects('en')).map((project) => ({
    params: { slug: `${getSlug('projects', 'en')}/${projectSlug(project)}` },
    props: { route: 'projects' as const, project },
  }));
  return [...pages, ...cases];
}

const { route, project } = Astro.props;
---

{
  project ? (
    <CaseStudyPage project={project} locale={locale} />
  ) : route === 'projects' ? (
    <ProjectsPage locale={locale} />
  ) : route === 'home' ? (
    <HomePage locale={locale} />
  ) : (
    <PlaceholderPage route={route} locale={locale} />
  )
}
