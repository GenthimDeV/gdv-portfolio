---
import HomePage from '../components/HomePage.astro';
import PlaceholderPage from '../components/PlaceholderPage.astro';
import { getSlug, routeKeys } from '../i18n';

const locale = 'es';

export function getStaticPaths() {
  return routeKeys.map((route) => ({
    params: { slug: getSlug(route, 'es') },
    props: { route },
  }));
}

const { route } = Astro.props;
---

{route === 'home' ? <HomePage locale={locale} /> : <PlaceholderPage route={route} locale={locale} />}
