---
// Proyectos destacados del Inicio (colección `projects`).
import ProjectArticles from './ProjectArticles.astro';
import { getRoutePath, useTranslations, type Locale } from '../i18n';
import { getFeaturedProjects } from '../lib/projects';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const projects = await getFeaturedProjects(locale);

const link = 'py-2 text-caqui underline underline-offset-4 hover:text-texto-claro';
---

<section id="proyectos" aria-labelledby="proyectos-titulo" class="bg-fondo-profundo py-20 sm:py-26">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-16 px-4 sm:gap-18 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2
        id="proyectos-titulo"
        class="font-display text-[clamp(2.75rem,5vw,4.5rem)] leading-none text-texto-claro uppercase"
      >
        {t('projects.title')}
      </h2>
      <a href={getRoutePath('projects', locale)} class={`font-semibold ${link}`}>
        {t('projects.all')} <span aria-hidden="true">→</span>
      </a>
    </div>

    <ProjectArticles projects={projects} locale={locale} />
  </div>
</section>
