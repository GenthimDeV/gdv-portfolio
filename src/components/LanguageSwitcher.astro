---
import { getAlternates, localeLabels, useTranslations, type Locale, type RouteKey } from '../i18n';

interface Props {
  route: RouteKey;
  locale: Locale;
  projectSlug?: string;
}

const { route, locale, projectSlug } = Astro.props;
const t = useTranslations(locale);
const alternates = getAlternates(route, projectSlug);
---

<nav aria-label={t('lang.switch')}>
  <ul class="flex gap-2">
    {
      alternates.map((alt) => (
        <li>
          <a
            class="inline-block min-w-11 rounded-boton border-2 border-plano-3 px-3 py-2 text-center font-mono text-sm text-texto-suave hover:text-texto-claro aria-[current=true]:border-caqui aria-[current=true]:text-caqui"
            href={alt.path}
            hreflang={localeLabels[alt.locale].hreflang}
            lang={alt.locale}
            aria-current={alt.locale === locale ? 'true' : undefined}
            aria-label={`${alt.locale.toUpperCase()} (${localeLabels[alt.locale].name})`}
          >
            {alt.locale.toUpperCase()}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
