---
// Provisional: las páginas reales sustituyen este contenido en la fase 2+.
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, type Locale, type RouteKey } from '../i18n';

interface Props {
  route: RouteKey;
  locale: Locale;
}

const { route, locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout route={route} locale={locale}>
  <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6">
    <h1 class="font-display text-4xl tracking-wide text-texto-claro uppercase sm:text-6xl">{t(`page.${route}.title`)}</h1>
    <p class="mt-4 text-texto-suave">{t('page.placeholder')}</p>
  </div>
</BaseLayout>
