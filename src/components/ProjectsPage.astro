---
// Listado de todos los proyectos de la colección.
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectArticles from './ProjectArticles.astro';
import { useTranslations, type Locale } from '../i18n';
import { getProjects } from '../lib/projects';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = await getProjects(locale);
---

<BaseLayout route="projects" locale={locale}>
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-16 px-4 py-10 sm:gap-18 sm:px-6 sm:py-16">
    <h1 class="font-display text-[clamp(2.75rem,7vw,4.5rem)] leading-none text-texto-claro uppercase">
      {t('page.projects.title')}
    </h1>
    <ProjectArticles projects={projects} locale={locale} />
  </div>
</BaseLayout>
