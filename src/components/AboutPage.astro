---
// Sobre mí: trayectoria y tecnologías respaldadas por proyectos (sección invertida en caqui).
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjectPath, useTranslations, type Locale } from '../i18n';
import { getTechnologies, projectSlug } from '../lib/projects';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const technologies = await getTechnologies(locale);
---

<BaseLayout route="about" locale={locale}>
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 py-10 sm:px-6 sm:py-16">
    <h1 class="font-display text-[clamp(2.75rem,7vw,4.5rem)] leading-none text-texto-claro uppercase">
      {t('page.about.title')}
    </h1>
    <section aria-labelledby="trayectoria-titulo" class="flex max-w-3xl flex-col gap-5">
      <h2 id="trayectoria-titulo" class="font-mono text-xs tracking-[2px] text-caqui uppercase">
        {t('about.path.title')}
      </h2>
      <p class="text-[1.375rem] leading-normal font-medium text-texto-claro">{t('about.lead')}</p>
      <p class="text-[1.0625rem] leading-relaxed text-texto-suave">{t('about.body')}</p>
      <p class="text-[1.0625rem] leading-relaxed text-texto-suave">{t('about.path.pending')}</p>
    </section>
  </div>

  <section aria-labelledby="tecnologias-titulo" class="bg-caqui py-20 text-fondo-profundo sm:py-26">
    <div class="mx-auto flex w-full max-w-6xl flex-wrap items-start gap-14 px-4 sm:px-6">
      <div class="flex flex-[1_1_280px] flex-col gap-5">
        <h2 id="tecnologias-titulo" class="font-display text-[clamp(2.75rem,5vw,4.5rem)] leading-none uppercase">
          {t('about.tech.title')}
        </h2>
        <p class="text-[1.0625rem] leading-relaxed">{t('about.tech.lead')}</p>
      </div>
      <ul class="flex min-w-0 flex-[2_1_480px] flex-col">
        {
          technologies.map((tech) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-6 border-t border-fondo-profundo/40 py-4 first:border-t-0 first:pt-0">
              <span class="font-display text-2xl leading-none uppercase">{tech.name}</span>
              <span class="flex flex-wrap gap-x-5">
                {tech.projects.map((project) => (
                  <a
                    href={getProjectPath(projectSlug(project), locale)}
                    class="py-2 text-base font-semibold underline underline-offset-4 hover:no-underline focus-visible:outline-fondo-profundo"
                  >
                    {project.data.title}
                  </a>
                ))}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
