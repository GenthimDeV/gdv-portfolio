---
// Experimento 01: cuatro escenas encadenadas por el color del hueco de la D.
// Sin JS o con menos movimiento se ven como láminas estáticas; con JS el scroll aplica el zoom (solo transform).
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const escenas = [
  { paleta: 'p0', rotulo: t('lab.d.s1') },
  { paleta: 'p1', rotulo: t('lab.d.s2') },
  { paleta: 'p2', rotulo: t('lab.d.s3') },
  { paleta: 'p0', rotulo: t('lab.d.s4') },
];
---

<section class="travesia" style={`--pasos: ${escenas.length - 1}`} aria-label={t('lab.d.label')}>
  <div class="escenario">
    {
      escenas.map((e) => (
        <figure class="lamina">
          <div class={`escena ${e.paleta}`} aria-hidden="true">
            <div class="comp">
              <div class="l1" />
              <div class="l2" />
              <div class="d">
                <div class="hueco" />
              </div>
            </div>
          </div>
          <figcaption class="rotulo">{e.rotulo}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .escenario { display: grid; gap: 2.5rem; max-width: 64rem; margin: 0 auto; padding: 0 1rem; }
  .lamina { margin: 0; position: relative; }
  .escena {
    position: relative; overflow: hidden; container-type: size;
    aspect-ratio: 16 / 10; background: var(--bg); border-radius: var(--radius-plano);
  }
  .rotulo {
    display: inline-block; margin-top: 0.75rem; padding: 0.35rem 0.7rem; border-radius: var(--radius-boton);
    background: var(--color-fondo-profundo); color: var(--color-texto-claro);
    font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase;
  }

  /* Composición: el hueco de la D, centrado en la escena, es el origen del zoom */
  .comp { position: absolute; inset: 0; }
  .comp > * {
    position: absolute; top: 50%; translate: 0 -50%;
    border-radius: 3px 40% 40% 3px / 3px 14% 14% 3px; box-shadow: 1.2cqmin 1.2cqmin 0 var(--color-sombra);
  }
  .l1 { width: 12cqmin; height: 40cqmin; right: calc(50% + 26.5cqmin); background: var(--l1); }
  .l2 { width: 20cqmin; height: 44cqmin; right: calc(50% + 10cqmin); background: var(--l2); }
  /* Sin translate propio: el de `.comp > *` (más específico con el alcance de Astro) lo anulaba y desplazaba la D media anchura */
  .d { width: 30cqmin; height: 48cqmin; left: calc(50% - 15cqmin); background: var(--d); display: grid; place-items: center; }
  .hueco {
    width: 46%; height: 64%; background: var(--hueco);
    border-radius: 2px 40% 40% 2px / 2px 14% 14% 2px; box-shadow: inset 1cqmin 1cqmin 0 rgb(0 0 0 / 0.38);
  }

  /* El hueco de cada escena tiene el color del fondo de la siguiente */
  .p0 { --bg: var(--color-fondo); --d: var(--color-caqui); --hueco: var(--color-texto-claro); --l1: var(--color-plano); --l2: var(--color-plano-3); }
  .p1 { --bg: var(--color-texto-claro); --d: var(--color-fondo); --hueco: var(--color-caqui); --l1: var(--color-texto-suave); --l2: var(--color-texto-apagado); }
  .p2 { --bg: var(--color-caqui); --d: var(--color-texto-claro); --hueco: var(--color-fondo); --l1: #8f8667; --l2: #7a7256; }

  /* Modo animado: lo activa el script */
  .travesia.animado { height: calc((var(--pasos) + 1) * 100svh); }
  .animado .escenario {
    position: sticky; top: 0; height: 100svh; display: block; max-width: none; padding: 0; overflow: hidden; background: var(--color-fondo);
  }
  .animado .lamina { position: absolute; inset: 0; }
  .animado .escena { position: absolute; inset: 0; aspect-ratio: auto; border-radius: 0; transform-origin: 50% 50%; }
  .animado .rotulo { position: absolute; left: 1rem; bottom: 1.25rem; margin: 0; opacity: 0; transition: opacity 0.2s; }
  .animado .lamina.activa .rotulo { opacity: 1; }
</style>

<script>
  const S = 28; // factor de escala por paso: el hueco a S× cubre el escenario hasta 21:9
  const seccion = document.querySelector<HTMLElement>('.travesia');

  if (seccion) {
    const laminas = [...seccion.querySelectorAll<HTMLElement>('.lamina')];
    const escenas = laminas.map((l) => l.querySelector<HTMLElement>('.escena')!);
    const pasos = laminas.length - 1;
    const menosMovimiento = matchMedia('(prefers-reduced-motion: reduce)');
    let pendiente = false;

    const pintar = () => {
      pendiente = false;
      const caja = seccion.getBoundingClientRect();
      const recorrido = caja.height - innerHeight;
      const p = recorrido > 0 ? Math.min(1, Math.max(0, -caja.top / recorrido)) : 0;
      const t = p * pasos;
      escenas.forEach((escena, k) => {
        const d = t - k;
        // Cubierta por la siguiente (d > 1) o demasiado pequeña (d < -2): no se pinta.
        escena.style.visibility = d > 1 || d < -2 ? 'hidden' : '';
        escena.style.transform = `scale(${S ** d})`;
      });
      const activa = Math.min(pasos, Math.floor(t + 0.1));
      laminas.forEach((l, k) => l.classList.toggle('activa', k === activa));
    };

    const alHacerScroll = () => {
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(pintar);
      }
    };

    const aplicarModo = () => {
      const animar = !menosMovimiento.matches;
      seccion.classList.toggle('animado', animar);
      if (animar) {
        addEventListener('scroll', alHacerScroll, { passive: true });
        addEventListener('resize', alHacerScroll);
        pintar();
      } else {
        removeEventListener('scroll', alHacerScroll);
        removeEventListener('resize', alHacerScroll);
        escenas.forEach((e) => {
          e.style.transform = '';
          e.style.visibility = '';
        });
        laminas.forEach((l) => l.classList.remove('activa'));
      }
    };

    menosMovimiento.addEventListener('change', aplicarModo);
    aplicarModo();
  }
</script>
